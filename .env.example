# =====================================================
# CONFIGURAÇÕES DO SISTEMA DE RECUPERAÇÃO DE CARRINHO
# =====================================================

# --- Servidor ---
PORT=3000

# --- Bestfy API ---
# Sua chave secreta da Bestfy (Configurações -> Credenciais de API)
BESTFY_SECRET_KEY=sua_chave_secreta_aqui

# --- WAHA (WhatsApp HTTP API) ---
# URL da sua instância WAHA (ex: http://localhost:3001 ou https://seu-waha.com)
WAHA_API_URL=http://localhost:3001
# Nome da sessão WAHA
WAHA_SESSION=default
# Chave de API do WAHA (se configurada)
WAHA_API_KEY=

# --- Configurações de Recuperação ---
# Tempo em minutos para enviar a mensagem após o abandono
RECOVERY_DELAY_MINUTES=30

# --- Mensagem de recuperação ---
# Use {nome} para o nome do cliente
# Use {produtos} para a lista de produtos
# Use {valor} para o valor total
# Use {link} para o link de pagamento
RECOVERY_MESSAGE=Olá {nome}! 👋\n\nNotamos que você não finalizou sua compra.\n\n🛒 *Itens no carrinho:*\n{produtos}\n\n💰 *Valor total:* R$ {valor}\n\nFinalize agora mesmo clicando no link abaixo:\n👉 {link}\n\nSe precisar de ajuda, é só responder esta mensagem! 😊
